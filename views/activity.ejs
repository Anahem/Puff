<%- include('partials/head', { pageTitle: 'Activity' }) %>
<%- include('partials/nav') %>

<main class="container">

  <div class="page-header">
    <h1>Activity</h1>
    <p class="page-subtitle"><%= activities.length %> event<%= activities.length !== 1 ? 's' : '' %> recorded this session</p>
  </div>

  <% if (activities.length === 0) { %>
    <div class="activity-empty-page">
      <p>No activity yet. Start by adding a member or logging an expense.</p>
    </div>
  <% } else { %>
    <div class="activity-timeline">
      <% activities.forEach(a => { %>
      <div class="timeline-item timeline-<%= a.type %>">

        <div class="timeline-dot"></div>

        <div class="timeline-content">
          <p class="timeline-headline"><%= a.headline %></p>
          <% if (a.detail) { %>
            <p class="timeline-detail"><%= a.detail %></p>
          <% } %>
          <time class="timeline-time">
            <%= new Date(a.timestamp).toLocaleString('en-GB', {
              weekday: 'short',
              day: 'numeric',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit'
            }) %>
          </time>
        </div>

      </div>
      <% }) %>
    </div>
  <% } %>

</main>

<%- include('partials/foot') %>
